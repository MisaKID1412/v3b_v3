# Copy this file to config/v3b.env. All paths may point outside this repository.

# Input. DATASET_DIR must contain input_images unless IMAGE_DIR is overridden.
DATASET_DIR=/path/to/room_dataset
IMAGE_DIR="$DATASET_DIR/input_images"
RUN_NAME=my_room_v3b_v3
# RUN_ROOT=/path/to/output/my_room_v3b_v3
GPU_ID=0

# Python environments. Keeping the proven separate environments is recommended.
DA3_PY=/path/to/da3-env/bin/python
ROOMFORMER_PY=/path/to/roomformer-env/bin/python
SAM3_PY=/path/to/sam3-env/bin/python
SD_PY=/path/to/reconstruction-env/bin/python
CHORD_PY=/path/to/chord-env/bin/python
# By default MatSeg uses SD_PY. Set this only when MatSeg has a separate env.
# MATSEG_PY=/path/to/matseg-env/bin/python

# LaMa completion through IOPaint.
IOPAINT_BIN=/path/to/reconstruction-env/bin/iopaint
IOPAINT_MODEL_DIR=/path/to/iopaint-model-cache
IOPAINT_MODEL=lama
IOPAINT_DEVICE=cuda
# IOPaint 1.5.3 stores the Big-LaMa JIT checkpoint below TORCH_HOME.
TORCH_HOME=/path/to/torch-cache

# DA3 and RoomFormer.
DA3_MODEL_DIR=/path/to/DA3-LARGE-1.1
ROOMFORMER_DIR=/path/to/RoomFormer
ROOMFORMER_CKPT_TIGHT=/path/to/roomformer_stru3d_tight.pth
ROOMFORMER_CKPT_BASE=/path/to/roomformer_stru3d.pth

# DA3 memory policy. "auto" enables the exact-math host-offload patch for
# sufficiently large view sets on <=12.5 GiB GPUs. Turing/older cards also
# select fp16 attention automatically instead of emulated bf16.
DA3_LOWMEM_OFFLOAD=auto
# DA3_AUTOCAST_DTYPE=float16

# SAM3. Leave empty only when the installed SAM3 runtime resolves its own weights.
SAM3_CHECKPOINT_PATH=

# MatSeg is an external checkout plus its trained checkpoint.
MATSEG_VENDOR_DIR=/path/to/matseg_zero_shot
MATSEG_CHECKPOINT=/path/to/Defult.torch

# Ubisoft LaForge CHORD is external and is not redistributed in this package.
CHORD_REPO=/path/to/ubisoft-laforge-chord
CHORD_CKPT=/path/to/chord_v1.safetensors
CHORD_CONFIG="$CHORD_REPO/config/chord.yaml"
# v3b_v3 uses the unchanged CHORD model at the 512x512 trace-back input size.
# Optional colon-separated cache roots are reused only by exact input hash.
CHORD_CACHE_ROOTS=
# The accepted server run was fully local/offline. Set both values to 0 only
# when the CHORD environment must download an upstream dependency on first use.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Optional known-camera input. If DATASET_DIR/camera_metadata.json exists, the
# main runner discovers it automatically. Otherwise leave this empty.
CAMERA_METADATA_JSON=

# Optional cached DA3 triple. The main runner also discovers
# DATASET_DIR/existing_da3/{results.npz,scene.glb,camera_poses.json}.
EXISTING_DA3_NPZ=
EXISTING_DA3_SCENE_GLB=
EXISTING_DA3_CAMERA_POSES=

# Generalized room/material controls. No L-room or fixed material-count rule.
ROOM_MIN_CORNERS=4
ROOM_MAX_CORNERS=20
ROOM_TARGET_CORNERS=0
MATERIAL_MAX_PER_FACE=8
MATERIAL_CLUSTER_COMPONENTS=4
MATERIAL_CLUSTER_MIN_FRACTION=0.01
MATERIAL_CLUSTER_MIN_REGION_SIZE=32

# Final territory synthesis.
ATLAS_RESOLUTION_SCALE=2.0
TARGET_UNITY_HEIGHT_M=2.7

# Resume controls. Existing outputs are never overwritten by default.
RESUME=0
RUN_FROM=frontend_reconstruction
RUN_UNTIL=unitypackage
